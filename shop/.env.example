# Copy to .env.local for local development. In production set these in the
# Vercel project settings. Never commit real values.

# Public URL of the main site (no trailing slash). The shop lives at $SITE_URL/shop.
SITE_URL=https://machinecanvas-wallandfloorprinting.com

# Supabase (Project settings -> API keys)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...

# Stripe (use test-mode keys first)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Resend (domain must be verified)
RESEND_API_KEY=re_...
EMAIL_FROM=Machine Canvas <bookings@machinecanvas-wallandfloorprinting.com>
OWNER_EMAIL=info@machinecanvas-wallandfloorprinting.com

# Comma-separated emails allowed into /shop/admin
ADMIN_EMAILS=info@machinecanvas-wallandfloorprinting.com

# Google Calendar via a service account (optional in development)
GOOGLE_SERVICE_ACCOUNT_EMAIL=shop-calendar@YOUR-GCP-PROJECT.iam.gserviceaccount.com
# The private_key from the JSON key file, with newlines as \n, in double quotes
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
GOOGLE_CALENDAR_ID=you@gmail.com

# Random string; Vercel Cron sends it as a Bearer token
CRON_SECRET=generate-a-long-random-string
